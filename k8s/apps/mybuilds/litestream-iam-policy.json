{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateBackupBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::homelab-backups-062700375181-us-west-1-an"
    },
    {
      "Sid": "ListMybuildsReplica",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::homelab-backups-062700375181-us-west-1-an",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "mybuilds",
            "mybuilds/*"
          ]
        }
      }
    },
    {
      "Sid": "ReplicateMybuildsDatabase",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::homelab-backups-062700375181-us-west-1-an/mybuilds/*"
    }
  ]
}
