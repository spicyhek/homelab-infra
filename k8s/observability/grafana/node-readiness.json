{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Kubernetes node readiness, pressure, and scheduling state. Node panels require a successful kube-state-metrics scrape within two minutes. AWS remains responsible for external reliability alerts.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ready nodes (expected: 3)",
      "description": "Nodes with Ready=True. Missing telemetry stays No data rather than becoming zero.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (node) (kube_node_status_condition{cluster=\"homelab\",condition=\"Ready\",status=\"true\"})) and on() (max(last_over_time(up{cluster=\"homelab\",job=\"integrations/kube-state-metrics\"}[2m])) == 1)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reporting nodes (expected: 3)",
      "description": "Includes Ready, NotReady, and Unknown nodes. A missing node reduces this count; loss of the collector produces No data.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (node) (kube_node_status_condition{cluster=\"homelab\",condition=\"Ready\",status=\"true\"})) and on() (max(last_over_time(up{cluster=\"homelab\",job=\"integrations/kube-state-metrics\"}[2m])) == 1)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Node-state scrape health",
      "description": "Latest scrape within two minutes. Down means Alloy cannot scrape the exporter; No data means telemetry has stopped arriving.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [ { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(up{cluster=\"homelab\",job=\"integrations/kube-state-metrics\"}[2m]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Node readiness",
      "description": "Ready=True is Ready; Ready=False is NotReady; Ready=Unknown is Unknown. Missing or failed telemetry leaves gaps.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "lineWidth": 0, "spanNulls": false, "insertNulls": 120000 },
          "noValue": "No data",
          "mappings": [ { "type": "value", "options": { "-1": { "text": "Unknown", "color": "orange" }, "0": { "text": "NotReady", "color": "red" }, "1": { "text": "Ready", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "auto", "rowHeight": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by (node) (kube_node_status_condition{cluster=\"homelab\",condition=\"Ready\",status=\"true\"}) - max by (node) (kube_node_status_condition{cluster=\"homelab\",condition=\"Ready\",status=\"unknown\"})) and on() (max(last_over_time(up{cluster=\"homelab\",job=\"integrations/kube-state-metrics\"}[2m])) == 1)",
          "legendFormat": "{{node}}",
          "interval": "60s",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Node pressure and network conditions",
      "description": "True indicates pressure or unavailable networking. Unknown conditions and missing telemetry are distinct from clear conditions.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "lineWidth": 0, "spanNulls": false, "insertNulls": 120000 },
          "noValue": "No data",
          "mappings": [ { "type": "value", "options": { "-1": { "text": "Unknown", "color": "orange" }, "0": { "text": "Clear", "color": "green" }, "1": { "text": "Active", "color": "red" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 0 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "auto", "rowHeight": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by (node, condition) (kube_node_status_condition{cluster=\"homelab\",condition=~\"MemoryPressure|DiskPressure|PIDPressure|NetworkUnavailable\",status=\"true\"}) - max by (node, condition) (kube_node_status_condition{cluster=\"homelab\",condition=~\"MemoryPressure|DiskPressure|PIDPressure|NetworkUnavailable\",status=\"unknown\"})) and on() (max(last_over_time(up{cluster=\"homelab\",job=\"integrations/kube-state-metrics\"}[2m])) == 1)",
          "legendFormat": "{{node}} / {{condition}}",
          "interval": "60s",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Node scheduling",
      "description": "A cordoned node may still be Ready. This panel shows the separate unschedulable flag.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "lineWidth": 0, "spanNulls": false, "insertNulls": 120000 },
          "noValue": "No data",
          "mappings": [ { "type": "value", "options": { "0": { "text": "Schedulable", "color": "green" }, "1": { "text": "Cordoned", "color": "orange" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "auto", "rowHeight": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (kube_node_spec_unschedulable{cluster=\"homelab\"}) and on() (max(last_over_time(up{cluster=\"homelab\",job=\"integrations/kube-state-metrics\"}[2m])) == 1)",
          "legendFormat": "{{node}}",
          "interval": "60s",
          "range": true
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["homelab", "kubernetes", "nodes"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Homelab node readiness",
  "uid": "homelab-node-readiness",
  "version": 1
}
